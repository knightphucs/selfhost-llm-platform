{
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:8080" }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Otel": {
    "Enabled": false,
    "Endpoint": "http://localhost:4317"
  },
  "ControlPlane": {
    "BaseUrl": "http://localhost:5001",
    "InternalToken": ""
  },
  "Gateway": {
    "SnapshotRefreshSeconds": 30,
    "UpstreamActivityTimeoutSeconds": 120
  },
  "AllowedHosts": "*"
}
